<odoo>
    <!-- Customer Fiscal Documents Action -->
    <record id="fiscal_invoice_out_action" model="ir.actions.act_window">
        <field name="name">Fiscal Documents</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="fiscal_invoice_search" />
        <field
            name="domain"
        >[('move_type', 'in', ('out_invoice', 'out_refund', 'out_receipt')), ('document_type_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice', 'journal_type': 'sale'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new Customer Fiscal Document</p>
            <p>Odoo helps you easily track all activities related to a fiscal operation.</p>
        </field>
    </record>

    <record id="fiscal_invoice_out_action_tree" model="ir.actions.act_window.view">
        <field eval="1" name="sequence" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="fiscal_invoice_tree" />
        <field name="act_window_id" ref="fiscal_invoice_out_action" />
    </record>

    <record id="fiscal_invoice_out_action_form" model="ir.actions.act_window.view">
        <field eval="2" name="sequence" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="fiscal_invoice_form" />
        <field name="act_window_id" ref="fiscal_invoice_out_action" />
    </record>

    <!-- Supplier Fiscal Documents Action -->
    <record id="fiscal_invoice_in_action" model="ir.actions.act_window">
        <field name="name">Fiscal Documents</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="fiscal_invoice_search" />
        <field
            name="domain"
        >[('move_type', 'in', ('in_invoice', 'in_refund', 'in_receipt')), ('document_type_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'in_invoice', 'journal_type': 'purchase'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new Supplier Fiscal Document</p>
            <p>Odoo helps you easily track all activities related to a fiscal operation.</p>
        </field>
    </record>

    <record id="fiscal_invoice_in_action_tree" model="ir.actions.act_window.view">
        <field eval="1" name="sequence" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="fiscal_invoice_tree" />
        <field name="act_window_id" ref="fiscal_invoice_in_action" />
    </record>

    <record id="fiscal_invoice_in_action_form" model="ir.actions.act_window.view">
        <field eval="2" name="sequence" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="fiscal_invoice_form" />
        <field name="act_window_id" ref="fiscal_invoice_in_action" />
    </record>

    <!-- Customer Fiscal Documents Menu -->
    <menuitem
        id="fiscal_invoice_out_menu"
        name="Fiscal Documents"
        action="fiscal_invoice_out_action"
        parent="account.menu_finance_receivables"
        sequence="50"
        groups="l10n_br_fiscal.group_user,l10n_br_fiscal.group_manager"
    />

    <!-- Supplier Fiscal Documents Menu -->
    <menuitem
        id="fiscal_invoice_in_menu"
        name="Fiscal Documents"
        action="fiscal_invoice_in_action"
        parent="account.menu_finance_payables"
        sequence="50"
        groups="l10n_br_fiscal.group_user,l10n_br_fiscal.group_manager"
    />
</odoo>
