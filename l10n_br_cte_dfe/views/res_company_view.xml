<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_company_form_cte_dfe" model="ir.ui.view">
        <field name="name">res.company.cte.dfe.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="CT-e DF-e">
                    <group>
                        <field name="cte_auto_fetch" />
                        <field name="cte_last_nsu" readonly="1" />
                        <field name="cte_max_nsu" readonly="1" />
                        <field name="cte_dfe_next_query" readonly="1" />
                        <field name="cte_dfe_last_query" readonly="1" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
